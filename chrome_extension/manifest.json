{
  "manifest_version": 3,
  "name": "DeepFlux Integration Module",
  "version": "1.0.0",
  "description": "Detect and download files and videos with DeepFlux's accelerated segmented engine.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepFlux Integration",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
